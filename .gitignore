# JavaScript
node_modules/
dist/
.vite/
coverage/
# TypeScript's incremental build cache. Machine-specific absolute paths and
# timestamps, so it conflicts on every branch and tells a reviewer nothing.
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.pyright/

# Environment and credentials
.env
.env.*
!.env.example
*.pem
*.key
*service-account*.json

# Local runtime data
.local-data/
apps/api/civiclens_demo.db
# OSM extracts: large, reproducible downloads. Provenance lives in osm_ingest_run,
# not in git.
data/osm/
.firebase/
firebase-debug.log

# Editors and OS
.idea/
.vscode/
.DS_Store

# Local coding-agent configuration. Deliberately not shared: it records how much
# this machine's owner trusts an agent (approval policy, sandbox mode), which is
# a per-machine decision and not one a clone should inherit silently.
.codex/
